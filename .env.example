# ==============================================================================
# WHY: Organizational Decision Memory System
# Environment Configuration Template
# ==============================================================================

# Application Environment (development | staging | production)
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="WHY"
VERSION="0.1.0"

# Server Configuration
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api

# CORS Configuration (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# Persistent Organizational Memory: HINDSIGHT
# ------------------------------------------------------------------------------
# Hindsight is the central long-term organizational memory layer.
# Supports local Hindsight (e.g. http://localhost:8888) or Hindsight Cloud.
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK_ID=finflow-why

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Provider abstraction supports groq, openai, anthropic, etc.
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ------------------------------------------------------------------------------
# Operational Database (PostgreSQL)
# ------------------------------------------------------------------------------
# Used strictly for standard operational/app data if needed.
# Long-term organizational memory is handled exclusively by Hindsight.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/why_db

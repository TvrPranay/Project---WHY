# Backend environment defaults
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="WHY"
VERSION="0.1.0"
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK_ID=finflow-why

LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/why_db
